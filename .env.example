# Copy to .env and adjust. .env is gitignored.

PORT=3000

# Signing certificate and private key produced by scripts/generate-certs.sh.
# These paths are read at startup; the files themselves are never committed.
C2PA_CERT_PATH=./certs/signing.crt
C2PA_KEY_PATH=./certs/signing.key

# Signature algorithm. Es256 = ECDSA P-256 with SHA-256.
C2PA_SIGN_ALG=es256

# Default institution written into the regulatory assertion when the request
# does not supply one.
DEFAULT_INSTITUTION=Demo Bank

# Maximum accepted upload size, bytes.
MAX_UPLOAD_BYTES=10485760
